# Скопируйте этот файл в .env.local и подставьте реальные значения.
# .env.local не коммитится (см. .gitignore).

# ---------------------------------------------------------------------------
# Neon Postgres (Prisma ORM v8)
# ---------------------------------------------------------------------------
# Одна строка подключения. Для рантайма приложения используйте pooled endpoint
# (в хосте есть суффикс "-pooler"). Для миграций и интроспекции удобнее
# unpooled (direct) хост — подставьте его в эту же переменную на время работ.
# Требуется PostgreSQL >= 15.
# ВНИМАНИЕ: драйвер `pg` предупреждает, что sslmode=require он трактует как
# verify-full. Чтобы убрать предупреждение, используйте sslmode=verify-full
# (или добавьте uselibpqcompat=true для libpq-совместимости).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=verify-full"

# ---------------------------------------------------------------------------
# Backblaze B2 (S3-compatible API)
# ---------------------------------------------------------------------------
# Endpoint всегда https://s3.<REGION>.backblazeb2.com, REGION должен совпадать
# с endpoint (например us-west-004). Схему https:// можно не указывать —
# код нормализует значение сам.
S3_ENDPOINT="https://s3.us-west-004.backblazeb2.com"
S3_REGION="us-west-004"
S3_BUCKET="your-bucket-name"
# Application Key ID / Application Key из Backblaze (не master key).
S3_ACCESS_KEY_ID="your-key-id"
S3_SECRET_ACCESS_KEY="your-application-key"
# Backblaze B2 работает только с path-style адресацией.
S3_FORCE_PATH_STYLE="true"
# Необязательно: базовый URL для публичных объектов (CDN или public bucket).
S3_PUBLIC_BASE_URL=""
