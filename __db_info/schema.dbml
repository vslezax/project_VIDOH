//   ON payments (provider, idempotency_key) WHERE idempotency_key IS NOT NULL;
//
// Если промокоды должны быть регистронезависимыми, добавь отдельную миграцию
// с UNIQUE INDEX promo_codes_code_ci_unique ON promo_codes (lower(code));
// Перед её созданием проверь и устрани существующие дубли без учёта регистра.
//
// Межтабличные правила (например, совпадение event_id в orders, tickets и
// issued_tickets) требуют проверки приложением либо специальных триггеров.
//
// Метро: станция уникальна в рамках города (без учёта регистра — на уровне приложения)
// В DBML UNIQUE (city_id, name) уже есть; при необходимости регистронезависимости:
// CREATE UNIQUE INDEX metro_stations_city_name_ci_unique ON metro_stations (city_id, lower(name));
//
// Иконка ветки должна быть именно image и ролью metro_line_icon —
// проверка на уровне приложения (media.type = 'image' AND media_role = 'metro_line_icon'),
// т.к. media не привязана к роли в самой таблице (роль задаётся контекстом использования).
